language: velme/0.1

# P1 benchmark, DMN TCK 0087 (loan origination). Plan text restates requirements.md section by section;
# the examples are the same ones the Python baseline gets (examples.json).

type Applicant:
    age: Number
    marital_status: Text
    employment_status: Text
    existing_customer: Boolean
    monthly_income: Number
    monthly_repayments: Number
    monthly_expenses: Number

type Product:
    product_type: Text
    rate: Number
    term: Number
    amount: Number

type Bureau:
    bankrupt: Boolean
    credit_score: Number

type Decision:
    application_risk_score: Number
    pre_bureau_risk_category: Text
    required_monthly_installment: Number
    pre_bureau_affordability: Boolean
    eligibility: Text
    bureau_call_type: Text
    strategy: Text
    post_bureau_risk_category: Text
    post_bureau_affordability: Boolean
    routing: Text

goal ApplicationRiskScore(applicant: Applicant) -> Number:
    plan: "Sum three point values. Age: 18 up to but not including 22 gives 32; 22 up to but not including 26 gives 35; 26 up to but not including 36 gives 40; 36 up to but not including 50 gives 43; 50 or over gives 48. Marital status: \"S\" gives 25, \"M\" gives 45. Employment status: \"UNEMPLOYED\" gives 15, \"STUDENT\" gives 18, \"EMPLOYED\" gives 45, \"SELF-EMPLOYED\" gives 36."
    examples:
        - ApplicationRiskScore(Applicant(age: 51, marital_status: "M", employment_status: "EMPLOYED", existing_customer: false, monthly_income: 10000, monthly_repayments: 2500, monthly_expenses: 3000)) == 138
        - ApplicationRiskScore(Applicant(age: 18, marital_status: "S", employment_status: "STUDENT", existing_customer: false, monthly_income: 500, monthly_repayments: 0, monthly_expenses: 100)) == 75
        - ApplicationRiskScore(Applicant(age: 30, marital_status: "S", employment_status: "SELF-EMPLOYED", existing_customer: true, monthly_income: 4000, monthly_repayments: 300, monthly_expenses: 1200)) == 101

goal PreBureauRiskCategory(existing_customer: Boolean, score: Number) -> Text:
    plan: "For a new customer: score below 100 is \"HIGH\"; 100 up to but not including 120 is \"MEDIUM\"; 120 to 130 inclusive is \"LOW\"; above 130 is \"VERY LOW\". For an existing customer: below 80 is \"DECLINE\"; 80 up to but not including 90 is \"HIGH\"; 90 to 110 inclusive is \"MEDIUM\"; above 110 is \"LOW\"."
    examples:
        - PreBureauRiskCategory(false, 138) == "VERY LOW"
        - PreBureauRiskCategory(false, 110) == "MEDIUM"
        - PreBureauRiskCategory(true, 75) == "DECLINE"
        - PreBureauRiskCategory(true, 100) == "MEDIUM"

goal RequiredMonthlyInstallment(product: Product) -> Number:
    plan: "The monthly repayment plus a monthly fee. The fee is 20.00 for \"STANDARD LOAN\" and 25.00 for any other product type, such as \"SPECIAL LOAN\". With r = annual rate / 12 and n = term in months, the monthly repayment is (amount * r) / (1 - (1 + r)^(-n)). A product whose rate is not above 0 or above 1, or whose term is not a whole number from 1 to 600, has no repayment: its installment is the monthly fee alone. Nothing is rounded."
    examples:
        - RequiredMonthlyInstallment(Product(product_type: "STANDARD LOAN", rate: 0.08, term: 36, amount: 0)) == 20
        - RequiredMonthlyInstallment(Product(product_type: "SPECIAL LOAN", rate: 0.05, term: 12, amount: 0)) == 25

goal Affordability(applicant: Applicant, risk_category: Text, installment: Number) -> Boolean:
    plan: "Disposable income is monthly income minus (monthly repayments plus monthly expenses). The credit contingency factor is 0.6 for \"HIGH\" or \"DECLINE\", 0.7 for \"MEDIUM\", 0.8 for \"LOW\" or \"VERY LOW\". Affordable when disposable income times the factor is strictly greater than the installment."
    examples:
        - Affordability(Applicant(age: 40, marital_status: "M", employment_status: "EMPLOYED", existing_customer: false, monthly_income: 5000, monthly_repayments: 500, monthly_expenses: 1500), "LOW", 2000) == true
        - Affordability(Applicant(age: 40, marital_status: "M", employment_status: "EMPLOYED", existing_customer: false, monthly_income: 5000, monthly_repayments: 500, monthly_expenses: 1500), "HIGH", 2000) == false
        - Affordability(Applicant(age: 40, marital_status: "M", employment_status: "EMPLOYED", existing_customer: false, monthly_income: 5000, monthly_repayments: 500, monthly_expenses: 1500), "MEDIUM", 2100) == false

goal Eligibility(risk_category: Text, affordable: Boolean, age: Number) -> Text:
    plan: "\"INELIGIBLE\" if the pre-bureau risk category is \"DECLINE\", or pre-bureau affordability is false, or the applicant is under 18; otherwise \"ELIGIBLE\"."
    examples:
        - Eligibility("LOW", true, 30) == "ELIGIBLE"
        - Eligibility("DECLINE", true, 30) == "INELIGIBLE"
        - Eligibility("LOW", true, 17) == "INELIGIBLE"
        - Eligibility("LOW", false, 40) == "INELIGIBLE"

goal BureauCallType(risk_category: Text) -> Text:
    plan: "From the pre-bureau risk category: \"HIGH\" or \"MEDIUM\" gives \"FULL\"; \"LOW\" gives \"MINI\"; any other category, such as \"VERY LOW\" or \"DECLINE\", gives \"NONE\". The comparison is exact."
    examples:
        - BureauCallType("MEDIUM") == "FULL"
        - BureauCallType("LOW") == "MINI"
        - BureauCallType("DECLINE") == "NONE"

goal Strategy(eligibility: Text, bureau_call_type: Text) -> Text:
    plan: "\"DECLINE\" if ineligible. For an eligible applicant, \"BUREAU\" when the bureau call type is \"FULL\" or \"MINI\", and \"THROUGH\" when it is \"NONE\"."
    examples:
        - Strategy("INELIGIBLE", "FULL") == "DECLINE"
        - Strategy("ELIGIBLE", "MINI") == "BUREAU"
        - Strategy("ELIGIBLE", "NONE") == "THROUGH"

goal PostBureauRiskCategory(existing_customer: Boolean, score: Number, credit_score: Number) -> Text:
    plan: "New customer with score below 120: credit score below 590 is \"HIGH\", 590 to 610 inclusive is \"MEDIUM\", above 610 is \"LOW\". New customer with score 120 to 130 inclusive: credit score below 600 is \"HIGH\", 600 to 625 inclusive is \"MEDIUM\", above 625 is \"LOW\". New customer with score above 130: \"VERY LOW\". Existing customer with score 100 or below: credit score below 580 is \"HIGH\", 580 to 600 inclusive is \"MEDIUM\", above 600 is \"LOW\". Existing customer with score above 100: credit score below 590 is \"HIGH\", 590 to 615 inclusive is \"MEDIUM\", above 615 is \"LOW\"."
    examples:
        - PostBureauRiskCategory(false, 110, 600) == "MEDIUM"
        - PostBureauRiskCategory(false, 125, 650) == "LOW"
        - PostBureauRiskCategory(false, 140, 300) == "VERY LOW"
        - PostBureauRiskCategory(true, 90, 570) == "HIGH"
        - PostBureauRiskCategory(true, 105, 620) == "LOW"

goal Routing(risk_category: Text, affordable: Boolean, bankrupt: Boolean, credit_score: Number) -> Text:
    plan: "\"DECLINE\" if post-bureau affordability is false or the applicant is bankrupt; otherwise \"REFER\" if the post-bureau risk category is \"HIGH\" or the credit score is below 580; otherwise \"ACCEPT\"."
    examples:
        - Routing("LOW", true, false, 650) == "ACCEPT"
        - Routing("LOW", false, false, 650) == "DECLINE"
        - Routing("MEDIUM", true, true, 650) == "DECLINE"
        - Routing("LOW", true, false, 560) == "REFER"
        - Routing("HIGH", true, false, 700) == "REFER"

goal DecideLoan(applicant: Applicant, product: Product, bureau: Bureau) -> Decision:
    call:
        score = ApplicationRiskScore(applicant)
        pre_category = PreBureauRiskCategory(applicant.existing_customer, score)
        installment = RequiredMonthlyInstallment(product)
        pre_affordable = Affordability(applicant, pre_category, installment)
        eligibility = Eligibility(pre_category, pre_affordable, applicant.age)
        call_type = BureauCallType(pre_category)
        strategy = Strategy(eligibility, call_type)
        post_category = PostBureauRiskCategory(applicant.existing_customer, score, bureau.credit_score)
        post_affordable = Affordability(applicant, post_category, installment)
        routing = Routing(post_category, post_affordable, bureau.bankrupt, bureau.credit_score)
    plan: "Return a Decision holding each value above in its field."
    examples:
        - DecideLoan(Applicant(age: 51, marital_status: "M", employment_status: "EMPLOYED", existing_customer: false, monthly_income: 10000, monthly_repayments: 2500, monthly_expenses: 3000), Product(product_type: "STANDARD LOAN", rate: 0.08, term: 36, amount: 0), Bureau(bankrupt: false, credit_score: 650)) == Decision(application_risk_score: 138, pre_bureau_risk_category: "VERY LOW", required_monthly_installment: 20, pre_bureau_affordability: true, eligibility: "ELIGIBLE", bureau_call_type: "NONE", strategy: "THROUGH", post_bureau_risk_category: "VERY LOW", post_bureau_affordability: true, routing: "ACCEPT")
