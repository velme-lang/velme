            "goal": {
              "description": "The child goal's name.",
              "type": "string"
            },
            "goal_signature": {
              "description": "The child's signature fingerprint (R-IR-09).",
              "type": "string"
            },
            "kind": {
              "const": "call",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "binding",
            "goal",
            "goal_signature",
            "args"
          ],
          "type": "object"
        }
      ]
    },
    "Lambda": {
