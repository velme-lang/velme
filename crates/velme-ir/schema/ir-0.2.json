  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One IR goal: the envelope of `compiler/21` §2.",
  "properties": {
    "body": {
      "$ref": "#/$defs/Node",
      "description": "The one expression computing the output (R-IR-03)."
    },
    "builtins_version": {
      "description": "Version of the builtin catalog the `builtin` nodes are resolved against.",
      "type": "string"
    },
    "calls": {
      "description": "Child goal calls, in source order; compiler-produced only, omitted in synthesized IR (R-IR-02, R-IR-09).",
      "items": {
        "$ref": "#/$defs/CallNode"
      },
      "type": "array"
    },
    "goal": {
      "description": "Name of the goal this IR implements.",
      "type": "string"
    },
    "inputs": {
      "description": "Goal inputs `[name, type]`, in declaration order.",
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/Type"
          }
        ],
        "type": "array"
      },
      "type": "array"
    },
    "ir_version": {
      "description": "IR version, `MAJOR.MINOR` (R-IR-22).",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/Type",
      "description": "Declared output type."
    },
    "types": {
      "additionalProperties": {
        "$ref": "#/$defs/RecordType"
      },
      "description": "Every record type reachable from the goal, by name (R-IR-01).",
      "type": "object"
    }
  },
  "required": [
    "ir_version",
    "builtins_version",
    "goal",
    "types",
    "inputs",
    "output",
    "body"
  ],
  "title": "Goal",
  "type": "object"
}
