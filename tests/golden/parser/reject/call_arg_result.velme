# covers: call_arg, path
# `result` as a call argument, alone or inside an expression (R-GOAL-23), a path followed by a stray name, and a path
# ending in `.`. Any other expression as an argument parses and is rejected by the checker (R-GOAL-08,
# `sema/reject/call_block.velme`).
goal A(p: Player) -> Number:
    call:
        x = Score(result)
        w = Score(result.score + 1)
        y = Score(p.score q)
        z = Score(p.)
