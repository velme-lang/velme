# Naming conventions are warnings, never errors (R-SYN-06, D-69).
type player_stats:
    jumpHeight: Number

goal find_badge(PlayerName: Text) -> Text:
    call:
        BestScore = Score(PlayerName)
        result = Badge(BestScore)

goal Score(name: Text) -> Number:
    plan: "Count the letters."

goal Badge(score: Number) -> Text:
    plan: "Pick a badge."
